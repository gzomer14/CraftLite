{
  "name": "craftlite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CraftLite — jogo de mundo aberto em voxels no navegador. Zero dependencias de runtime.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "size": "node scripts/size-report.mjs",
    "icons": "node scripts/make-icons.mjs",
    "soak": "node scripts/soak.mjs",
    "slow-network": "node scripts/slow-network.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
